{
  "files.associations": {
    "*.feature": "feature"
  },
  "gherkin-behave.featuresPath": "no_behave",
  "cucumberautocomplete.steps": [
    "tests/step_defs/**/*.py"
  ],
  "cucumberautocomplete.syncfeatures": "features/**/*.feature",
  "cucumberautocomplete.gherkinDefinitionPart": "@(given|when|then|step)\\((?:parsers\\.(?:(?:cf)?parse|re)\\()?",
  "cucumberautocomplete.strictGherkinValidation": false,
  "cucumberautocomplete.smartSnippets": true,
  "cucumberautocomplete.customParameters": [
    {
      "parameter": "{[a-zA-Z0-9_:]+}",
      "value": ".*",
      "isRegex": true
    }
  ],
  "cucumber.features": [
    "features/**/*.feature"
  ],
  "cucumber.glue": [
    "tests/step_defs/**/*.py"
  ],
  "cucumber.parameterTypes": [
    { "name": "username", "regexp": ".*" },
    { "name": "password", "regexp": ".*" },
    { "name": "expected_message", "regexp": ".*" },
    { "name": "user_id", "regexp": ".*" },
    { "name": "status_code:d", "regexp": "\\d+" },
    { "name": "expected_username", "regexp": ".*" },
    { "name": "first_name", "regexp": ".*" },
    { "name": "last_name", "regexp": ".*" },
    { "name": "expected_first_name", "regexp": ".*" }
  ],
  "editor.quickSuggestions": {
    "comments": false,
    "strings": true,
    "other": true
  },
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.extraPaths": [
    "${workspaceFolder}"
  ],
  "files.trimTrailingWhitespace": true
}
